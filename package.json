{
  "name": "taskade-sample-app",
  "version": "1.0.0",
  "description": "Taskade Genesis App Kit Template — Build, validate, and import Workspace DNA bundles",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "npx tsx scripts/validate.ts",
    "assemble": "npx tsx scripts/assemble.ts",
    "import": "npx tsx scripts/import.ts",
